# Copie para .env. Nunca inclua este arquivo com valores reais no Git.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-com-mais-de-50-caracteres
BOOTSTRAP_PASSWORD=troque-por-uma-senha-local-forte
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:5173
DATABASE_ENGINE=postgresql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=rob8
DATABASE_USER=rob8
DATABASE_PASSWORD=troque-por-outra-senha-local-forte
SEND_MODE=simulated
TEST_RECIPIENTS=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v24.0
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_THICK=1
ORACLE_CLIENT_DIR=
