# Número visível do canal; diferente do ID técnico da Meta.
META_DISPLAY_PHONE_NUMBER=

# Fernet key, generated once; required to save Meta credentials. Back up separately.
META_CREDENTIALS_KEY=

# Stable UUID for this installation, and independent Fernet key for remote credentials.
ORBITA_INSTANCE_ID=
INSTANCE_CREDENTIALS_KEY=

# Report-only Baileys service; generate independent strong secrets on the server.
REPORT_BAILEYS_TOKEN=
REPORT_BAILEYS_AUTH_KEY=
REPORT_BAILEYS_ALLOW_SENDS=0
